# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no setup needed)
DATABASE_URL=sqlite:///./loan_engine.db
# PostgreSQL (use this in Docker / production)
# DATABASE_URL=postgresql://user:password@localhost:5432/loan_db

# ── OpenAI GPT-4o (LLM Explainability) ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=paddleocr

# ── ML Model ──────────────────────────────────────────────────────────────────
MODEL_REGISTRY_PATH=./ml
ACTIVE_MODEL_VERSION=v1.0.0
FALLBACK_MODE=rule_based

# ── n8n Orchestration ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loan-application-webhook

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
